# Database
DATABASE_URL=postgresql://domzop:domzop@localhost:5432/domzop

# Redis
REDIS_URL=redis://localhost:6379/0

# CertStream (public, no key required)
CERTSTREAM_URL=wss://certstream.calidog.io/

# Target platform suffixes (comma-separated)
TARGET_SUFFIXES=.vercel.app,.netlify.app,.onrender.com

# Namecheap API (registrar)
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_CLIENT_IP=
NAMECHEAP_SANDBOX=true

# Quality gate (OpenAI vision or compatible endpoint)
OPENAI_API_KEY=
QUALITY_SCORE_THRESHOLD=75
QUALITY_EVAL_MIN_DAYS=3
QUALITY_EVAL_MAX_DAYS=5

# Polling
POLL_INTERVAL_HOURS=24
MAX_MONITORING_DAYS=14

# Purchase limits
MAX_PURCHASE_PRICE_USD=12
AUTO_PURCHASE_ENABLED=false

# Research lab bots
REPORT_INTERVAL_MINUTES=60

# Admin
ADMIN_API_SECRET=change-me-in-production
NEXT_PUBLIC_ADMIN_SECRET=change-me-in-production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Copy values into Vercel Project Settings → Environment Variables
# (or local admin/.env.local). Do not commit real secrets.

# Required for live dashboard data (Postgres). Optional at build time —
# the admin UI degrades to empty states when unset.
DATABASE_URL=

# Required for queue actions (purchase/report enqueue). Optional at build —
# bot status queues show zeros when unset.
REDIS_URL=

# Protects mutating admin API routes (POST). If empty, auth checks are skipped.
ADMIN_API_SECRET=

# Public site URL (set to your Vercel production URL after deploy)
NEXT_PUBLIC_APP_URL=

# Optional client-side secret mirror if the UI sends x-admin-secret
NEXT_PUBLIC_ADMIN_SECRET=

# Optional: used to enrich property intelligence narratives.
# Heuristic narratives always work without this key.
OPENAI_API_KEY=
